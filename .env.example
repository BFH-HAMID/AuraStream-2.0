# API Keys for AuraStream 2.0 - Advanced Edition
GEMINI_API_KEY=your_gemini_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# Hugging Face Advanced AI (NEW - Makes project ultra advanced)
# Get free API key from: https://huggingface.co/settings/tokens
# Enables: SDXL thumbnails, Mistral script fallback, MusicGen, NLLB translation, sentiment analysis
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Telegram AI Agent + Alerts
# 1. Talk to @BotFather on Telegram -> /newbot -> copy the token
# 2. TELEGRAM_BOT_TOKEN powers BOTH the alerts and the full Telegram AI Agent
#    Run the agent:  python telegram_agent.py   (or: docker compose --profile agent up)
# 3. TELEGRAM_CHAT_ID is only needed for push alerts (get it from @userinfobot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Auto-pilot scheduler timezone (default: Asia/Dhaka)
SCHEDULER_TZ=Asia/Dhaka
# Optional: default narration voice for videos (see /voices in the bot)
# DEFAULT_TTS_VOICE=en-US-ChristopherNeural
